{
  "name": "pipeai",
  "version": "0.10.0",
  "description": "A typed multi-agent workflow pipeline built on top of the Vercel AI SDK",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepublishOnly": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.0",
    "@types/node": "^25.9.1",
    "ai": "^7.0.4",
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "agent",
    "workflow",
    "pipeline",
    "multi-agent",
    "vercel-ai-sdk",
    "orchestrator",
    "llm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MOSMekawy/pipeai.git"
  }
}
